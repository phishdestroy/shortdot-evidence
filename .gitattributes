* text=auto eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.png binary
*.gif binary
*.svg text eol=lf

# Workflow files are committed with CRLF; normalizing them makes the bot's
# "git add" stage workflow changes, which GITHUB_TOKEN is not allowed to push.
.github/workflows/*.yml -text -eol
